    {
      "name": "Razorpay Payments & Receipts",
      "item": [
        {
          "name": "Create Razorpay Order for Accepted Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.orderId) {",
                  "    pm.collectionVariables.set(\"razorpayOrderId\", res.data.orderId);",
                  "    pm.collectionVariables.set(\"bookingId\", String(res.data.bookingId));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/create-order/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "create-order",
                "{{bookingId}}"
              ]
            },
            "description": "Creates Razorpay order with amount in paise, currency INR, and keyId for frontend checkout."
          },
          "response": []
        },
        {
          "name": "Verify Razorpay Payment Signature",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const orderId = pm.collectionVariables.get(\"razorpayOrderId\") || \"order_TYl6nqBKeBq2vr\";",
