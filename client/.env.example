# ==============================================================================
# AutoRent Enterprise - Frontend Environment Configuration
# ==============================================================================
#
# 1. LOCAL DEVELOPMENT:
#    Leave VITE_API_BASE_URL empty or set to /api/v1 to use Vite's built-in proxy:
#    VITE_API_BASE_URL=/api/v1
#
# 2. PRODUCTION (VERCEL DEPLOYMENT):
#    In Vercel Project Dashboard -> Settings -> Environment Variables:
#    Set VITE_API_BASE_URL to your deployed backend API URL:
#    VITE_API_BASE_URL=https://your-backend-api.onrender.com/api/v1
#
# Note: For cross-domain cookies to work between Vercel (*.vercel.app) and your backend,
# ensure your backend has JWT_COOKIE_SECURE=true and JWT_COOKIE_SAME_SITE=None.
# ==============================================================================

VITE_API_BASE_URL=http://localhost:1571/api/v1
